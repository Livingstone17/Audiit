# Supabase project credentials.
#
# Create a project at https://supabase.com/dashboard, then copy these values
# from Project Settings → API into a local `.env` file (`.env` is git-ignored):
#
#   cp .env.example .env
#
# When both values are present the app signs users in through Supabase and
# mirrors learner progress to Postgres. When they are absent, the app runs in
# local-only mode off localStorage.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
